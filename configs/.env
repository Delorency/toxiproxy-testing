# Toxiproxy конфигурация
TOXIPROXY_HOST=localhost
TOXIPROXY_API_PORT=8474
TOXIPROXY_PROXY_PORT=8666

# Retry паттерн
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY=50ms
RETRY_MAX_DELAY=500ms
RETRY_MULTIPLIER=2.0
RETRY_JITTER=true

# Circuit Breaker паттерн
CB_THRESHOLD=20
CB_HALF_OPEN_SUCCESS=2
CB_TIMEOUT=5s

# Timeout паттерн
TIMEOUT_DEFAULT=2s

# Bulkhead паттерн
BULKHEAD_MAX_CONCURRENT=10

# Rate Limiter паттерн
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=100

# Seed
DETERMINISTIC_SEED=42

# Логирование
LOG_LEVEL=info
LOG_FORMAT=text

# Демонстрационный HTTP-сервер
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_DEFAULT_SLOW_MS=500
SERVER_DEFAULT_ERROR_RATE=0.3
SERVER_MIDDLEWARE=false

SERVER_RATE_LIMIT_RPS=200
SERVER_RATE_LIMIT_BURST=200

SERVER_BULKHEAD_MAX=100
SERVER_BULKHEAD_WAIT=10ms

SERVER_REQUEST_TIMEOUT=2s

# Раннер сценариев
RUNNER_SCENARIOS_DIR=scenarios
RUNNER_RESULTS_DIR=results
RUNNER_FIXTURES_DIR=fixtures
